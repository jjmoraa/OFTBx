from pathlib import Path
import shutil


class Turbine:
    """
    Lightweight wrapper around an OpenFAST turbine definition.
    
    Responsibilities:
    - Store reference to template case (data folder)
    - Provide metadata
    - Create isolated sandbox runs
    """

    def __init__(self, name: str, template_path: str):
        self.name = name
        self.template_path = Path(template_path).resolve()

        if not self.template_path.exists():
            raise FileNotFoundError(
                f"Turbine template not found: {self.template_path}"
            )

    def create_sandbox(self, run_name: str, runs_dir: str = "runs"):
        """
        Creates a clean working directory for a simulation.
        Copies the full OpenFAST case into a new folder.
        """

        run_dir = Path(runs_dir) / run_name

        # ensure clean state
        if run_dir.exists():
            shutil.rmtree(run_dir)

        shutil.copytree(self.template_path, run_dir)

        return run_dir

    def __repr__(self):
        return f"Turbine(name={self.name}, template={self.template_path})"